# Avenit — zmienne środowiskowe produkcji (VPS). Skopiuj do .env i uzupełnij.
# NIE commituj pliku .env.

# ── Domena i TLS ─────────────────────────────────────────────────────
APP_DOMAIN=avenit.pl
ACME_EMAIL=admin@avenit.pl
# TLS jest on-demand (HTTP-01) — nie wymaga wtyczki DNS ani tokenu.
# Wymóg: rekord DNS wildcard  *.avenit.pl  A → IP VPS (u dowolnego providera).

# ── Baza danych ──────────────────────────────────────────────────────
POSTGRES_USER=avenit
POSTGRES_PASSWORD=ZMIEN_MNIE_dlugie_haslo

# ── Sekrety aplikacji ────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=ZMIEN_MNIE_losowy_sekret
# openssl rand -base64 32  (szyfrowanie haseł SMTP/IMAP modułu Mail)
MAIL_ENCRYPTION_SECRET=

# ── E-mail ───────────────────────────────────────────────────────────
SENDGRID_API_KEY=
MAILING_FROM_EMAIL=noreply@avenit.pl
MAILING_FROM_NAME=Avenit
# Fallback SMTP dla e-maili systemowych, gdy brak SendGrid (np. skrzynka lh.pl)
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=
# Adresat powiadomień o zgłoszeniach z formularza na stronie głównej
LANDING_CONTACT_EMAIL=lukasz@avenit.pl
# Resend — używany przez windykację (process-dunning)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@avenit.pl

# ── SMS (SMSAPI.pl) ──────────────────────────────────────────────────
SMSAPI_TOKEN=
SMSAPI_DEFAULT_SENDER=
SMSAPI_WEBHOOK_SECRET=

# ── Push ─────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:lukasz@avenit.pl

# ── Połączenia audio/wideo (LiveKit, usługa `livekit`) ───────────────
# Puste = połączenia wyłączone (API zwraca 503 calls_disabled, web chowa przyciski),
# a kontener livekit nie wystartuje (restartuje się w pętli — nieszkodliwe).
# Klucze wygeneruj RAZ (tylko litery i cyfry — trafiają do YAML):
#   docker run --rm livekit/livekit-server:v1.13.9 generate-keys
# albo: echo "API$(openssl rand -hex 6)"  i  openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Publiczny adres sygnalizacji dla klientów; puste = wss://rtc.<APP_DOMAIN> (Caddy → livekit:7880).
LIVEKIT_URL=
# Firewall VPS (np. panel Hostinger / ufw): otwórz 7881/tcp i 7882/udp (media WebRTC).
# DNS: rtc.<APP_DOMAIN> obejmuje istniejący rekord wildcard *.<APP_DOMAIN>.

# ── Płatności Przelewy24 (opcjonalne) ────────────────────────────────
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# ── Backup offsite (opcjonalne, rclone) ──────────────────────────────
# Nazwa remote rclone + ścieżka; puste = tylko backup lokalny.
BACKUP_RCLONE_REMOTE=

# ── AI (Claude / Anthropic) ──────────────────────────────────────────
# Wymagane przez moduł Asystent AI (/api/fn/ai-assist). Klucz z console.anthropic.com.
ANTHROPIC_API_KEY=
